    "work-package.manuscript.recovery": {
      "comment": "Recovery explanation for invalid data. Manuscript is a Folio domain term.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The store contains invalid or unsupported Manuscript structure; no content has been changed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ストアに無効または非対応の原稿構造が含まれています。内容は変更されていません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le stockage contient une structure de manuscrit incorrecte ou non prise en charge ; aucun contenu n’a été modifié."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يحتوي المخزن على بنية مخطوط غير صالحة أو غير مدعومة؛ لم يُغيَّر أي محتوى."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O armazenamento contém uma estrutura de manuscrito inválida ou incompatível; nenhum conteúdo foi alterado."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "저장소에 유효하지 않거나 지원되지 않는 원고 구조가 있습니다. 내용은 변경되지 않았습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El almacén contiene una estructura de manuscrito no válida o no compatible; no se ha modificado ningún contenido."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "存储中包含无效或不受支持的原稿结构；未更改任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "儲存區包含無效或不支援的原稿結構；未更改任何內容。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’archivio contiene una struttura del manoscritto non valida o non supportata; nessun contenuto è stato modificato."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Datenspeicher enthält eine ungültige oder nicht unterstützte Manuskriptstruktur. Es wurden keine Inhalte geändert."
          }
        }
      }
    },
