    "work-package.save-verification.error": {
      "comment": "Error when save verification fails. Reassure the user that the previous package remains intact.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Work could not be saved without losing information. The previous saved package has not been replaced."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "情報を失わずに作品を保存できませんでした。以前保存したパッケージは置き換えられていません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’œuvre n’a pas pu être enregistrée sans perte d’informations. Le paquet précédemment enregistré n’a pas été remplacé."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعذر حفظ العمل دون فقدان معلومات. لم تُستبدل الحزمة المحفوظة سابقًا."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não foi possível salvar a obra sem perder informações. O pacote salvo anteriormente não foi substituído."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "정보 손실 없이 저작물을 저장할 수 없습니다. 이전에 저장된 패키지는 대치되지 않았습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se pudo guardar la obra sin perder información. No se ha reemplazado el paquete guardado anteriormente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "无法在不丢失信息的情况下存储作品。先前存储的包尚未被替换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "無法在不遺失資訊的情況下儲存作品。先前儲存的套件尚未被取代。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non è stato possibile salvare l’opera senza perdere informazioni. Il pacchetto salvato in precedenza non è stato sostituito."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das Werk konnte nicht ohne Informationsverlust gesichert werden. Das zuvor gesicherte Paket wurde nicht ersetzt."
          }
        }
      }
    },
    "work-package.structure.recovery": {
      "comment": "Recovery advice for an invalid package. Preserve the filename Work.sqlite.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expected a native Work package containing Work.sqlite. Extra files and unfamiliar formats are left untouched."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Work.sqliteを含むネイティブ形式の作品パッケージが必要です。追加のファイルや不明な形式は変更されません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un paquet d’œuvre natif contenant Work.sqlite était attendu. Les fichiers supplémentaires et les formats inconnus sont laissés intacts."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يلزم وجود حزمة عمل أصلية تحتوي على Work.sqlite. ستُترك الملفات الإضافية والتنسيقات غير المعروفة دون تغيير."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Era esperado um pacote nativo de obra contendo Work.sqlite. Arquivos adicionais e formatos desconhecidos são mantidos intactos."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Work.sqlite가 포함된 기본 형식의 저작물 패키지가 필요합니다. 추가 파일과 알 수 없는 형식은 변경하지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se esperaba un paquete de obra nativo con Work.sqlite. Los archivos adicionales y los formatos desconocidos se dejan intactos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "需要包含 Work.sqlite 的原生作品包。额外文件和未知格式将保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "需要包含 Work.sqlite 的原生作品套件。其他檔案和未知格式將保持不變。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Era previsto un pacchetto nativo dell’opera contenente Work.sqlite. I file aggiuntivi e i formati sconosciuti vengono lasciati intatti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Erwartet wurde ein natives Werkpaket mit Work.sqlite. Zusätzliche Dateien und unbekannte Formate bleiben unverändert."
          }
        }
      }
    },
    "work-package.version.recovery": {
      "comment": "Recovery advice for an unsupported Work model version. Write is the app name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Work uses a different model version. Open it with a compatible version of Write."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この作品は異なるモデルバージョンを使用しています。互換性のあるバージョンのWriteで開いてください。"
          }
        },
        "fr": {
          "stringUnit": {
