    "formatting.conflict.accessibility-help": {
      "comment": "Accessibility help for the formatting conflict marker; Bold and Italic are appearance choices.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bold or Italic overlaps semantic emphasis. Show conversion and dismissal options."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "太字または斜体が意味上の強調と重複しています。変換と警告を非表示にするオプションを表示します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le gras ou l’italique se superpose à l’emphase sémantique. Afficher les options de conversion et de masquage de l’avertissement."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يتداخل الخط العريض أو المائل مع التوكيد الدلالي. عرض خيارات التحويل وتجاهل التحذير."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Negrito ou itálico se sobrepõe à ênfase semântica. Mostrar opções de conversão e de dispensa do aviso."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "볼드체 또는 이탤릭체가 의미적 강조와 겹칩니다. 변환 및 경고 닫기 옵션을 표시합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La negrita o la cursiva se superpone al énfasis semántico. Mostrar opciones de conversión y descarte."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "粗体或斜体与语义强调重叠。显示转换和忽略警告选项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "粗體或斜體與語意強調重疊。顯示轉換與忽略警告的選項。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il grassetto o il corsivo si sovrappone all’enfasi semantica. Mostra le opzioni di conversione e chiusura dell’avviso."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fett- oder Kursivschrift überlagert semantische Betonung. Optionen zum Umwandeln und Ausblenden der Warnung anzeigen."
          }
        }
      }
    },
