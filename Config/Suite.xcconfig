// Minimum supported macOS version for every Suite target and compiled resource.
MACOSX_DEPLOYMENT_TARGET = 26.5

// Use Clang modules and scan/build their dependencies explicitly across the Suite.
// Each Kit supplies its supported headers through its own <Kit>.modulemap.
CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_EXPLICIT_MODULES = YES

// One release identity for all apps, Kits, tests, and bundled services.
#include "Version.xcconfig"

// Shared Kits in the traditional Suite installation.
LD_RUNPATH_SEARCH_PATHS = $(inherited) /Library/Frameworks
