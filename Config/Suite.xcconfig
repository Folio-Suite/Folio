// Follow Apple's recommended minimum: macOS 14.0 with Xcode 27.
// Recheck the resolved minimum when upgrading Xcode.
MACOSX_DEPLOYMENT_TARGET = $(RECOMMENDED_MACOSX_DEPLOYMENT_TARGET)

// Use Clang modules and scan/build their dependencies explicitly across the Suite.
// Each Kit supplies its supported headers through its own <Kit>.modulemap.
CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_EXPLICIT_MODULES = YES

// Shipping builds do not need test-coverage counters or coverage mapping.
// Debug retains Xcode's coverage setting for the test schemes.
ENABLE_CODE_COVERAGE[config=Release] = NO

// One release identity for all apps, Kits, tests, and bundled services.
#include "Version.xcconfig"

// Common bundle attribution for apps, frameworks, tests, and services.
INFOPLIST_KEY_NSHumanReadableCopyright = Copyright © 2026 the Folio Project

// Shared Kits in the traditional Suite installation.
LD_RUNPATH_SEARCH_PATHS = $(inherited) /Library/Frameworks
