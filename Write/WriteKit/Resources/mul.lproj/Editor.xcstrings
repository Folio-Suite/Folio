    "conflict-detail-message-cell.title": {
      "comment": "Bold or Italic overlaps semantic emphasis. Convert the highlighted text throughout this Co — textFieldCell title: \"Bold or Italic overlaps semantic emphasis. Convert the highlighted text throughout this Content Unit, or keep its presentation.\" in Editor. Keep Folio domain terms consistent with the glossary.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bold or Italic overlaps semantic emphasis. Convert the highlighted text throughout this Content Unit, or keep its presentation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "太字または斜体が意味上の強調と重複しています。このコンテンツ単位全体のハイライトされたテキストを変換するか、表示書式を保持してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le gras ou l’italique se superpose à l’emphase sémantique. Convertissez le texte surligné dans toute cette unité de contenu ou conservez sa présentation."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يتداخل الخط العريض أو المائل مع التوكيد الدلالي. حوّل النص المميز في وحدة المحتوى بأكملها أو احتفظ بطريقة عرضه."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Negrito ou itálico se sobrepõe à ênfase semântica. Converta o texto destacado em toda esta unidade de conteúdo ou mantenha sua apresentação."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "볼드체 또는 이탤릭체가 의미적 강조와 겹칩니다. 이 콘텐츠 단위 전체에서 표시된 텍스트를 변환하거나 표시 서식을 유지하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La negrita o la cursiva se superpone al énfasis semántico. Convierta el texto resaltado en toda esta unidad de contenido o conserve su presentación."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "粗体或斜体与语义强调重叠。请转换此内容单元中所有高亮显示的文本，或保留其呈现样式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "粗體或斜體與語意強調重疊。請轉換此內容單元中所有標示的文字，或保留其呈現樣式。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il grassetto o il corsivo si sovrappone all’enfasi semantica. Converti il testo evidenziato in tutta questa unità di contenuto oppure mantieni la presentazione."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fett- oder Kursivschrift überlagert semantische Betonung. Den markierten Text in dieser gesamten Inhaltseinheit umwandeln oder seine Darstellung beibehalten."
          }
        }
      }
    },
