    "appearance-bold.ibShadowedToolTip": {
      "comment": "Apply visual bold independently of semantic emphasis. — button ibShadowedToolTip: \"Apply visual bold independently of semantic emphasis.\" in Editor. Keep Folio domain terms consistent with the glossary.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply visual bold independently of semantic emphasis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "意味上の強調とは独立して、見た目の太字を適用します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Appliquer du gras visuel indépendamment de l’emphase sémantique."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تطبيق الخط العريض بصريًا بصورة مستقلة عن التوكيد الدلالي."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aplicar negrito visual independentemente da ênfase semântica."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "의미적 강조와 독립적으로 시각적 볼드체를 적용합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aplicar negrita visual independientemente del énfasis semántico."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "单独应用视觉粗体，不影响语义强调。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "獨立套用視覺上的粗體，不影響語意強調。"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Applica il grassetto visivo indipendentemente dall’enfasi semantica."
          }
